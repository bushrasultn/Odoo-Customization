<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_Teacher_form" model="ir.ui.view">
            <field name="name">school.partner.form</field>
            <field name="model">school.partners</field>
            <field name="arch" type="xml">
                <form string="Teacher">
                    <sheet>
<!--                          <div class="oe_button_box" name="button_box">-->
<!--                        <button class="oe_start_button" type="object" name="action_view_admissions" icon="fa-star">-->
<!--                            <field name="admission_count" widget="statinfo"/>-->
<!--                        </button>-->
<!--                    </div>-->
                        <field name="image" widget="image" class="oe_avatar"/>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="father_name" invisible="is_teacher == True"/>
                                <field name="email"/>
                                <field name="address"/>
                                <field name="contact"/>
                                <field name="cnic"/>
                                <field name="admission_date" invisible="is_student == False"/>
                                <field name="admission_time" invisible="is_teacher == True"/>
                                <field name="qualification" invisible="is_student == True"/>
                            </group>
                            <group>
                                <field name="date_of_birth" default_focus="1"/>
                                <field name="is_teacher"/>
                                <field name="is_student"/>
                                <field name="gender"/>
                                <field name="reference" readonly="True"/>
                                <field name="note"/>
                                <field name="activity_ids" widget="list_activity"/>
                                <field name="state"/>
                            </group>
<!--                            <group string="Count" name="admission_count">-->
<!--                        <field name="admission_count"/>-->
<!--                    </group>-->
                            <group></group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_student_teacher_tree" model="ir.ui.view">
            <field name="name">school.partner.form</field>
            <field name="model">school.partners</field>
            <field name="arch" type="xml">
                <tree string="Teacher">
                    <field name="name"/>
                    <field name="cnic"/>
                    <!--                     <field name="father_name"/> -->
                    <field name="email"/>
                    <field name="address"/>
                    <field name="reference"/>
                    <field name="note"/>
                    <field name="state" widget="badge" decoration-success="state=='confirmed'"
                           decoration-danger="state=='done'"/>
                    <field name="contact" optional="hide"/>
                    <field name="activity_ids" widget="boolean_toggle"/>
                    <field name="date_of_birth" optional="hide"/>
                    <field name="is_teacher" optional="hide"/>
                    <field name="is_student" optional="hide"/>
                    <field name="gender" optional="hide"/>
                </tree>
            </field>
        </record>
        <record id="action_student_management" model="ir.actions.act_window">
            <field name="name">student</field>
            <field name="res_model">school.partners</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_is_student':True, 'default_is_teacher':False}</field>
            <field name="domain">[('is_student','=', True)]</field>
        </record>
        <record id="action_teacher_management" model="ir.actions.act_window">
            <field name="name">Teachers</field>
            <field name="res_model">school.partners</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_is_teacher':True, 'default_is_student':False}</field>
            <field name="domain">[('is_teacher','=', True)]</field>
        </record>
        <menuitem id="menu_school_management_system_root" name="School" sequence="0"/>
        <menuitem id="menu_teacher_root" name="Teacher" action="action_teacher_management"
                  parent="menu_school_management_system_root" sequence="1"/>
        <menuitem id="menu_Student_root" name="Student" action="action_student_management"
                  parent="menu_school_management_system_root" sequence="2"/>
    </data>
</odoo>