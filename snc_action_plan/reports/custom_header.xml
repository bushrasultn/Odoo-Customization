<odoo>
    <data>
        <!--  HTML Layout  -->
        <template id="snc_html_id">

            <!-- Header Section -->

            <div class="header" style="text-align: center; margin-bottom: 20px;">
                    <div style="text-align: center;">
                        <p style="font-size: 18px; font-weight: bold; margin: 0;">
                            <t t-esc="company_name"/>
                        </p>
                        <p style="margin: 0;">
                            <t t-esc="company_street"/>
                        </p>
                    </div>
                </div>

        </template>

        <!--  PDF Layout  -->
        <template id="snc_pdf_id">
            <t t-set="company" t-value="res_company"/>

            <!-- Header Section -->

            <div class="header" style="text-align: center; margin-bottom: 20px;">
                    <div style="text-align: center;">
                        <p style="font-size: 18px; font-weight: bold; margin: 0;">
                            <t t-esc="company_name"/>
                        </p>
                        <p style="margin: 0;">
                            <t t-esc="company_street"/>
                        </p>
                    </div>
                </div>

            <!-- Footer Section -->

            <div class="footer" style="font-size: 8px; text-align: center; margin-top: 20px;">
                <div class="row">
                    <div class="col-xs-6 text-right fw-bold">
                        Page <span class="page"/> of <span class="topage"/>
                    </div>
                </div>
            </div>
        </template>
    </data>
</odoo>