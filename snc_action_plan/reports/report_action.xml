<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="portrait_report_format_id" model="report.paperformat">
            <field name="name">A4 Portrait Format</field>
            <field name="default" eval="False"/>
            <field name="format">custom</field>
            <field name="page_width">210</field>
            <field name="page_height">297</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">25</field>
            <field name="margin_bottom">25</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">20</field>
            <field name="dpi">90</field>
        </record>
        <record id="landscape_report_format_id" model="report.paperformat">
            <field name="name">Landscape A4</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="orientation">Landscape</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
        </record>
<!--######################################################################-->
<!--##                                                                  ##-->
<!--##                   Monthly Region_Achievement Report             ##-->
<!--##                                                                  ##-->
<!--######################################################################        -->
        <record id="view_action_region_achievement" model="ir.actions.report">
            <field name="name">Region Wise Report</field>
            <field name="model">event.event</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">snc_action_plan.region_achievement_id</field>
            <field name="report_file">snc_action_plan.region_achievement_id</field>
            <field name="paperformat_id" ref="snc_action_plan.portrait_report_format_id"/>
        </record>
         <record id="download_action_region_achievement" model="ir.actions.report">
            <field name="name">Region Wise Report</field>
            <field name="model">event.event</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">snc_action_plan.region_achievement_id</field>
            <field name="report_file">snc_action_plan.region_achievement_id</field>
            <field name="paperformat_id" ref="snc_action_plan.portrait_report_format_id"/>
        </record>
<!--######################################################################-->
