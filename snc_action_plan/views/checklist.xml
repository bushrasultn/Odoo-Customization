<odoo>
    <data>
        <record id="view_checklist_form" model="ir.ui.view">
            <field name="name">check.list.form</field>
            <field name="model">check.list</field>
            <field name="arch" type="xml">
                <form string="Checklist">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        <record id="view_checklist_tree" model="ir.ui.view">
            <field name="name">check.list.tree</field>
            <field name="model">check.list</field>
            <field name="arch" type="xml">
                <tree string="Checklist">
                    <field name="name"/>
                </tree>
            </field>
        </record>
        <record id="action_checklist" model="ir.actions.act_window">
            <field name="name">Event Checklists</field>
            <field name="res_model">check.list</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_checklist_tree"/>
        </record>
        <menuitem id="checklist_id" name="CheckPoints" parent="event.menu_event_configuration"
                  action="action_checklist"/>

        <!--        ####################################################################################-->
        <record id="view_event_crops" model="ir.ui.view">
            <field name="name">event.crop.form</field>
            <field name="model">event.crop</field>
            <field name="arch" type="xml">
                <form string="Checklist">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="company_id"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        <record id="view_event_crops_tree" model="ir.ui.view">
            <field name="name">event.crop.tree</field>
            <field name="model">event.crop</field>
            <field name="arch" type="xml">
                <tree string="Checklist">
                    <field name="name"/>
                </tree>
            </field>
        </record>
        <record id="action_event_crops" model="ir.actions.act_window">
            <field name="name">Name</field>
            <field name="res_model">event.crop</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_event_crops_tree"/>
        </record>
        <menuitem id="event_crops_id" name="Crops" parent="event.menu_event_configuration"
                  action="action_event_crops"/>
        <!--        ####################################################################################-->
        <record id="view_event_type_form_inherit" model="ir.ui.view">
            <field name="name">event.type.form.inherit</field>
            <field name="model">event.type</field>
            <field name="inherit_id" ref="event.view_event_type_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Checklist">
                        <field name="checklist_line_ids">
                            <tree editable="bottom">
                                <field name="checklist_id" options="{'no_create': True}" force_save="1"
                                       width="100"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
        <!--        ###########################################EVENT INHERITED FORM##############################-->
        <record id="view_event_event_form_inherit" model="ir.ui.view">
            <field name="name">event.event.form.inherit</field>
            <field name="model">event.event</field>
            <field name="inherit_id" ref="event.view_event_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='event_notes']" position="after">
                    <page string="Check list">
                        <field name="event_checklist_line_ids">
                            <tree editable="bottom">
                                <field name="check_list_id"/>
<!--                                <field name="name"/>-->
                                <field name="is_active"/>
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
        <!--        ###########################################################-->
        <record id="view_event_registration_form_inherit" model="ir.ui.view">
            <field name="name">event.registration.form.inherit</field>
            <field name="model">event.registration</field>
            <field name="inherit_id" ref="event.view_event_registration_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="land_area"/>
                </xpath>
                <xpath expr="//field[@name='land_area']" position="after">
                    <field name="phone_no"/>
                </xpath>
                <xpath expr="//field[@name='phone']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='event_ticket_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
