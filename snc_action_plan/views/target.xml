<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--  Form view of NAP Targets  -->
    <record id="view_target_form_view" model="ir.ui.view">
        <field name="name">nap.target.form.view</field>
        <field name="model">nap.target</field>
        <field name="arch" type="xml">
            <form string="Target">
                <sheet>
                    <group>
                        <group>
                            <field name="year"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
<!--                            <field name="mng_level"/>-->
                            <field name="event_type"/>
                            <field name="event_target"/>
                        </group>
                        <group>
                            <field name="company"/>
                            <field name="region_ids" widget="many2many_tags"/>
                            <field name="territory" widget="many2many_tags"/>
                        </group>
                    </group>

                    <!--  Notebook for Comment section  -->

                    <notebook>
                        <page string="Territory">
                            <button name="action_add_lines" type="object"
                                    string="Create" class="oe_highlight"
                                    style="min-width: 150px;"/>
                            <field name="terr_lines">
                                <tree editable="bottom">
                                    <field name="territory" width="200"/>
                                    <field name="event_type" width="200"/>
                                    <field name="event_target" width="200"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Comments">
                            <field name="comments"/>
                        </page>
                    </notebook>

                </sheet>

                <!--  Chatter for Tracking purposes  -->

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>

            </form>
        </field>
    </record>

    <!--  Tree view of NAP Targets  -->

    <record id="view_target_tree_view" model="ir.ui.view">
        <field name="name">nap.target.tree.view</field>
        <field name="model">nap.target</field>
        <field name="arch" type="xml">
            <tree>
                <field name="year" width="200"/>
                <field name="start_date" width="200"/>
                <field name="end_date" width="200"/>
<!--                <field name="mng_level" width="200"/>-->
                <field name="company" width="200"/>
                <field name="region_ids" optional="Hide"/>
                <field name="territory" width="200"/>
                <field name="event_type" width="200"/>
                <field name="event_target" width="200"/>
            </tree>
        </field>
    </record>
</odoo>