<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Territory Wizard Form View -->
    <record id="view_territory_form" model="ir.ui.view">
        <field name="name">Territory Wizard Form</field>
        <field name="model">territory.wizard</field>
        <field name="arch" type="xml">
            <form string="Territory Wise Achievement">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="region"/>
                        <field name="territory_id"
                               domain="[('region_id', '=', region)]"
                               widget="many2many_tags" invisible="1"/>
                    </group>
                    <group>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button name="view_report" string="View Report"
                            type="object" class="btn-primary"/>
                    <button name="download_report" string="Download Report"
                            type="object" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Territory Wizard Action -->
    <record id="action_territory_wizard" model="ir.actions.act_window">
        <field name="name">Territory Wise Achievements</field>
        <field name="res_model">territory.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_territory_form"/>
        <field name="target">new</field>
    </record>

    <!-- Territory Menu Item -->
    <menuitem id="menu_territory_report"
              name="Territory Report"
              parent="event.menu_reporting_events"
              action="action_territory_wizard"
              sequence="13"/>
</odoo>
