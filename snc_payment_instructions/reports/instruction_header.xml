<odoo>
    <data>
        <template id="instruction_header_id">
            <t t-set="company" t-value="res_company"/>
            <!--  Header Section  -->
            <div class="header" style="text-align: center; margin-bottom: 20px;">
                <div class="row" style="border-bottom: 1px solid #000; padding-bottom: 10px;">
                    <div class="col-2">
                        <t t-set="logo" t-value="company.logo and company.logo.decode('utf-8') or ''"/>
                        <img t-att-src="'data:image/png;base64,' + logo" style="max-height: 80px;" alt="Company Logo"/>
                    </div>
                    <div class="col-8" style="text-align: center;">
                        <p style="font-size: 18px; font-weight: bold; margin: 0;">
                            <t t-esc="company.name"/>
                        </p>
                        <p style="margin: 0;">
                            <t t-esc="company.partner_id.street"/>
                        </p>
                    </div>
                </div>
            </div>
            <!--  Raw content section  -->
            <t t-raw="content"/>
            <div class="footer" style="text-align: left; margin-top: 20px; white-space: nowrap;">
                <t t-foreach="docs" t-as="o"/>
                <p style="display: inline-block; width: 150px; margin-right: 50px; text-align:left;font-size: 14px;">
                    <span t-field="o.submit_by.short_code"/>
                    <br>Prepared By: ___________________</br>
                </p>
                <p style="display: inline-block; width: 180px; margin-right: 50px; text-align:left;font-size: 14px;">
                    <span t-esc="o.review_by.short_code"/>
                    <br>Reviewed By: ___________________</br>
                </p>
                <p style="display: inline-block; width: 180px; margin-right: 50px; text-align:left;font-size: 14px;">
                    <span t-esc="o.approval_by.short_code"/>
                    <br>Audit Manager: ___________________</br>
                </p>
                <p style="display: inline-block; width: 180px; margin-right: 50px; text-align:left;font-size: 14px;">
                    <span t-esc="o.approve_by.short_code"/>
                    <br>Approved By: ___________________</br>
                </p>
                <div style="display: flex; align-items: center; margin-top: 10px; font-size: 12px;">
                    <span>
                        Print By:
                        <span t-esc="request.env.user.short_code"/>
                    </span>
                    <span style="margin-left: 30px;">
                        Print Date/Time:
                        <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M')"/>
                    </span>
                </div>
            </div>
        </template>
    </data>
</odoo>