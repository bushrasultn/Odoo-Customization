<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_pymnt_instruction_method_form" model="ir.ui.view">
            <field name="name">pymnt_instruction.method.form</field>
            <field name="model">pymnt_instruction.method</field>
            <field name="arch" type="xml">
                <form string="Instruction Method">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        <record id="view_instruction_method_tree" model="ir.ui.view">
            <field name="name">pymnt_instruction.method.tree</field>
            <field name="model">pymnt_instruction.method</field>
            <field name="arch" type="xml">
                <tree string="Instruction Method">
                    <field name="name"/>
                </tree>
            </field>
        </record>
        <record id="action_method_type" model="ir.actions.act_window">
            <field name="name">Method Type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">pymnt_instruction.method</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_instruction_method_tree"/>
        </record>
        <menuitem id="menu_mthod_category"
                  name="Configuration"
                  parent="menu_payment_instruction"
                  sequence="2"/>

        <menuitem id="menu_methd_type"
                  name="Instruction Method TYpe"
                  parent="menu_mthod_category"
                  action="action_method_type"
                  sequence="2"/>
    </data>
</odoo>