<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

       <record id="custom_account_form_id" model="ir.ui.view">
           <field name="name">Custom Account</field>
           <field name="model">custom.accounts</field>
           <field name="arch" type="xml">
               <form string="_form">
                   <sheet>
                       <div class="oe_title">
                           <h2>
                               <field name="name" readonly="1"/>
                           </h2>
                       </div>
                   </sheet>
                   <div class="oe_chatter">
                       <field name="message_follower_ids" readonly="1"/>
                       <field name="message_ids" readonly="1"/>
                   </div>
               </form>
           </field>
       </record>

       <record id="custom_account_tree_view" model="ir.ui.view">
           <field name="name">Custom Account Tree</field>
           <field name="model">custom.accounts</field>
           <field name="arch" type="xml">
               <tree create="false">
                   <field name="name"/>
               </tree>
           </field>
       </record>

       <record id="custom_account_action" model="ir.actions.act_window">
           <field name="name">Accounts</field>
           <field name="type">ir.actions.act_window</field>
           <field name="res_model">custom.accounts</field>
           <field name="view_mode">tree</field>
       </record>

       <menuitem id="custom_account_menu" name="Title of Accounts" parent="menu_mthod_category" action="custom_account_action" sequence="2"/>

    </data>
</odoo>
