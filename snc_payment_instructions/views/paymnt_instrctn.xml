<odoo>
    <record id="view_payment_instruction_form" model="ir.ui.view">
        <field name="name">payment.instruction.form</field>
        <field name="model">payment.instruction</field>
        <field name="arch" type="xml">
            <form string="Payment Instruction">
                <header>
                    <field name="state" widget="statusbar" readonly="True"/>
                    <button name="action_draft" type="object" string="Draft"
                            invisible="state in ('approved', 'paid')"
                            class="oe_highlight"/>
                    <button name="action_submit" type="object" string="Submit"
                            groups="snc_payment_instructions.view_payment_request" invisible="state not in ['draft']"
                            class="oe_highlight"/>
                    <button name="action_review" type="object" string="Review"
                            groups="snc_payment_instructions.view_payment_review" invisible="state not in ['submitted']"
                            class="oe_highlight"/>
                    <button name="action_approval" type="object" string="Audit Manager"
                            groups="snc_payment_instructions.view_payment_manager" invisible="state not in ['review']"
                            class="oe_highlight"/>
                    <button name="action_approve" type="object" string="Approve"
                            groups="snc_payment_instructions.view_payment_approve"
                            invisible="state != 'audit manager'"
                            class="oe_highlight"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('approved', 'paid')"
                            class="oe_highlight"/>
                    <button name="action_paid" type="object" string="Paid"
                            invisible="state in ('submitted', 'review','audit manager')"
                            class="oe_highlight"/>

                </header>
                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button name="open_partner_ledger_wizard" type="object" string="Report"
                                class="oe_highlight">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Open Report</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" force_save="True" readonly="True"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="party" readonly="state in ['audit manager','approved','paid']"/>
                            <field name="balance" readonly="state in ['audit manager','approved','paid']"/>
                            <field name="release" readonly="state in ['approved','paid']"/>
                            <field name="payment_against_inst" readonly="state in ['audit manager','approved','paid']"/>
                            <field name="amount_pay" readonly="1"/>
                            <field name="note"/>
                        </group>
                        <group>
                            <field name="date" readonly="state in ['audit manager','approved','paid']"/>
                            <field name="tax" widget="boolean_toggle"
                                   readonly="state in ['audit manager','approved','paid']"/>
                            <field name="tax_rate" invisible="not tax" readonly="state in ['approved','paid']"/>
                            <field name="tax_amount" invisible="not tax" readonly="1"/>
                            <field name="ntn" readonly="state in ['audit manager','approved','paid']"/>
                            <field name="payee" readonly="state in ['audit manager','approved','paid']"/>
                            <field name="account_ids" invisible="1"/>
                            <field name="submit_by" invisible="1"/>
                            <field name="review_by" invisible="1"/>
                            <field name="approval_by" invisible="1"/>
                            <field name="approve_by" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="In Favour of Cheques Details" invisible="payee">
                            <field name="account_lines" readonly="state in ['approved','paid']">
                                <tree editable="bottom">
                                    <field name="account_id" string="Account Title"
                                           domain="[('id','in', parent.account_ids)]" options="{'no_create': True}"/>
                                    <field name="bank" readonly="1" force_save="True"/>
                                    <field name="account_no" readonly="1" force_save="True"/>
                                    <field name="ntn" readonly="1" force_save="True"/>
                                    <field name="instruction"/>
                                    <field name="amount"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_amount"/>
                            </group>
                        </page>
                        <page string="Payee Not Registered" invisible="not payee">
                            <field name="register_lines" readonly="state in ['approved','paid']">
                                <tree editable="bottom">
                                    <field name="account_title" force_save="True"/>
                                    <field name="bank" force_save="True"/>
                                    <field name="account_no" force_save="True"/>
                                    <field name="ntn"/>
                                    <field name="instruction"/>
                                    <field name="non_payee_amount"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="payee_amount"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_payment_instruction_tree" model="ir.ui.view">
        <field name="name">payment.instruction.tree</field>
        <field name="model">payment.instruction</field>
        <field name="arch" type="xml">
            <tree string="Payment Instructions">
                <field name="name" string="Ref#"/>
                <field name="party"/>
                <field name="balance"/>
                <field name="release"/>
                <field name="payment_against_inst"/>
                <field name="tax_amount"/>
                <!--                <field name="tax"/>-->
                <field name="amount_pay"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="action_payment_instruction" model="ir.actions.act_window">
        <field name="name">Payment Instructions</field>
        <field name="res_model">payment.instruction</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
    </record>
    <menuitem id="menu_payment_instruction" name="Payment Instructions"/>
    <menuitem id="menu_instruction"
              name="Payment Instruction"
              parent="menu_payment_instruction"
              action="action_payment_instruction"
              sequence="1"/>


    <!--server action for updated states-->
    <record id="payment_instruction_state_action" model="ir.actions.server">
        <field name="name">Update States</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="model_payment_instruction"/>
        <field name="state">code</field>
        <field name="code">
            if records:
            action = records.update_states_from_logs()
        </field>
        <field name="binding_model_id" ref="model_payment_instruction"/>
    </record>

    <record id="payment_instruction_payment_against_action" model="ir.actions.server">
        <field name="name">Update Payment Against Field</field>
        <field name="type">ir.actions.server</field>
        <field name="model_id" ref="model_payment_instruction"/>
        <field name="state">code</field>
        <field name="code">
            if records:
            action = records.update_payment_against()
        </field>
        <field name="binding_model_id" ref="model_payment_instruction"/>
    </record>


</odoo>
