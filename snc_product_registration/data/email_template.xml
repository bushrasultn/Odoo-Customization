<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="email_pesticides" model="mail.template">
        <field name="name">Pesticides Email Template</field>
        <field name="model_id" ref="snc_product_registration.model_pesticides_reg"/>
        <field name="email_from">my.yt.collection@gmail.com</field>
        <field name="email_to">{{ (object.group_user_emails) }}</field>
        <field name="subject">{{ (object.sr_no) }} Expiry Notice</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size:13px;">
                    Dear Sir,
                    <br/><br/>
                    We would like to inform you that the product registration
                    under serial number <strong><t t-out="object.sr_no"/></strong>,
                    registered on <strong><t t-out="object.reg_date"/></strong>,
                    is approaching its expiration date.<br/> Expiration is due on
                    <strong><t t-out="object.expiry_date"/></strong>.
                    <br/><br/>
                    Kindly apply for renewal at your earliest convenience.
                    <br/><br/>
                    Best regards,<br/>
                    <strong>Team Actination</strong><br/>
                    <em>my.yt.collection@gmail.com</em>
                </p>
            </div>
        </field>
    </record>
</odoo>
