<data>
    <template id="pesticides_form_report">
        <t t-call="web.html_container">
            <t t-call="snc_product_registration.product_registration_header"/>
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="o">
                    <div class="page">
                        <div style="text-align: right; font-size: 14px; margin-top: 10px;">
                            <b>Date:</b>
                            <span t-esc="datetime.datetime.now().strftime('%d-%m-%Y')"/>
                        </div>
                        <h2 style="text-align: center; font-size: 20px; font-weight: bold; color: black; margin: 20px 0;">
                            Pesticides Report
                        </h2>
                        <style>
                            .custom-report-tables {
                            margin-top: 50px;
                            }
                            .custom-report-tables table {
                            width: 100%;
                            border-collapse: separate; /* Ensures margin works between rows */
                            border-spacing: 20px; /* Adjusted space between rows */
                            table-layout: auto;
                            }
                            .custom-report-tables td {
                            padding: 6px; /* Reduced padding */
                            vertical-align: top;
                            text-align: left;
                            font-size: 16px; /* Reduced font size */
                            white-space: nowrap; /* Prevents text wrapping */
                            }
                            .custom-report-tables td:first-child {
                            font-weight: bold;
                            width: 35%; /* Adjusted width */
                            }
                            .custom-report-tables td:last-child {
                            width: 65%; /* Adjusted width */
                            }
                            .custom-report-tables .row {
                            display: flex;
                            flex-wrap: nowrap; /* Prevents wrapping of tables */
                            }
                            .custom-report-tables .col-6,
                            .custom-report-tables .col-3 {
                            flex: 1; /* Ensures proper spacing */
                            min-width: 0; /* Prevents unnecessary overflow */
                            }
                        </style>

                        <div class="custom-report-tables">
                            <div class="row">
                                <div class="col-7">
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <td>Seq #:.</td>
                                            <td>
                                                <t t-esc="o.name"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>State:</td>
                                            <td>
                                                <t t-esc="o.state.capitalize()"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>SR #:.</td>
                                            <td>
                                                <t t-esc="o.sr_no"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Ref #:.</td>
                                            <td>
                                                <t t-esc="o.ref_no"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Product:</td>
                                            <td>
                                                <t t-esc="o.product.name"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Generic:</td>
                                            <td>
                                                <t t-esc="o.generic"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Brand:</td>
                                            <td>
                                                <t t-esc="o.brand"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <tr>
                                                <td>Undertaking:</td>
                                                <td>
                                                    <t t-esc="o.undertaking.name"/>
                                                </td>
                                            </tr>
                                        </tr>
                                        <tr>
                                            <td>Category:</td>
                                            <td>
                                                <t t-esc="o.category.name"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Province:</td>
                                            <td>
                                                <t t-esc="o.province.name"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="col-4">
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <td>Reg Date:</td>
                                            <td>
                                                <t t-if="o.reg_date">
                                                    <t t-esc="o.reg_date.strftime('%d-%m-%Y')"/>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Expiry Date:</td>
                                            <td>
                                                <t t-if="o.expiry_date">
                                                    <t t-esc="o.expiry_date.strftime('%d-%m-%Y')"/>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Apply Date:</td>
                                            <td>
                                                <t t-if="o.apply_date">
                                                    <t t-esc="o.apply_date.strftime('%d-%m-%Y')"/>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Renewal Date:</td>
                                            <td>
                                                <t t-if="o.renewal_date">
                                                    <t t-esc="o.renewal_date.strftime('%d-%m-%Y')"/>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Exp Agent:</td>
                                            <td>
                                                <t t-esc="o.exp_agent"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Ref Agent:</td>
                                            <td>
                                                <t t-esc="o.ref_agent"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Country:</td>
                                            <td>
                                                <t t-esc="o.country.name"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Crops:</td>
                                            <td>
                                                <t t-esc="o.crops"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Form Type:</td>
                                            <td>
                                                <t t-esc="o.form_type.name"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td>Province:</td>
                                            <td>
                                                <t t-esc="o.province.name"/>
                                            </td>
                                        </tr>

                                    </table>
                                </div>
                            </div>
                        </div>
                        <style>
                            table.table-custom {
                            width: 100%;
                            margin-top: 0px;
                            border: 1px solid black;
                            border-collapse: collapse;
                            }

                            table.table-custom th,
                            table.table-custom td {
                            border: 1px solid black;
                            font-size: 16px;
                            padding: 5px;
                            }

                            table.table-custom th {
                            text-align: center;
                            font-weight: bold;
                            text-transform: none;
                            }

                            table.table-custom td {
                            text-align: left;
                            }

                            table.table-custom td.text-right {
                            text-align: right;
                            }

                            table.table-custom td.bg-transparent {
                            background-color: transparent;
                            }

                            label {
                            font-size: 16px;
                            font-weight: bold;
                            }
                        </style>
                        <t t-if="o.formulation_lines">
                            <label>Formulation</label>
                            <table class="table table-sm table-bordered table-custom" style="color: black;">
                                <thead>
                                    <tr>
                                        <th style="text-transform: none;font-size: 14px;color: black;">
                                            <b>Formulation</b>
                                        </th>
                                        <th style="text-transform: none;font-size: 14px;color: black;">
                                            <b>Manufacture</b>
                                        </th>
                                        <th style="text-transform: none;font-size: 14px;color: black;">
                                            <b>License</b>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.formulation_lines" t-as="line">
                                        <tr>
                                            <td class="text-center">
                                                <span t-esc="line.formulation.name"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-esc="line.mnf_name"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-esc="line.license_no"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <t t-if="o.technical_lines">
                            <label>Technical</label>
                            <table class="table table-sm table-bordered table-custom" style="color: black;">
                                <thead>
                                    <tr>
                                        <th style="text-transform: none;font-size: 14px;color: black;">
                                            <b>Technical</b>
                                        </th>
                                        <th style="text-transform: none;font-size: 14px;color: black;">
                                            <b>Manufacture</b>
                                        </th>
                                        <th style="text-transform: none;font-size: 14px;color: black;">
                                            <b>License</b>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="o.technical_lines" t-as="line">
                                        <tr>
                                            <td class="text-center">
                                                <span t-esc="line.technical"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-esc="line.mnf_name"/>
                                            </td>
                                            <td class="text-center">
                                                <span t-esc="line.license_no"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                        <div>
                            <label class="fw-bold" style="margin-top:15px;font-size: 17px;">Remarks:</label>
                            <span t-esc="o.note"/>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</data>
