<odoo>
    <data>
        <template id="product_registration_header">
            <t t-set="company" t-value="res_company"/>
            <!--  Header Section  -->
            <div class="header" style="text-align: center; margin-bottom: 20px;">
                <div class="row" style="border-bottom: 1px solid #000; padding-bottom: 10px;">
                    <div class="col-2">
                        <t t-set="logo" t-value="company.logo and company.logo.decode('utf-8') or ''"/>
                        <img t-att-src="'data:image/png;base64,' + logo" style="max-height: 80px;" alt="Company Logo"/>
                    </div>
                    <div class="col-8" style="text-align: center;">
                        <p style="font-size: 18px; font-weight: bold; margin: 0;">
                            <t t-esc="company.name"/>
                        </p>
                        <p style="margin: 0;">
                            <t t-esc="company.partner_id.street"/>
                        </p>
                    </div>
                </div>
            </div>
            <!--  Raw content section  -->
            <t t-raw="content"/>
            <!--  Footer Section with Signature lines  -->
            <div class="footer" style="text-align: left; margin-top: 50px; white-space: nowrap;">
<!--                 <p style="font-weight: bold; display: flex; align-items: center; margin-bottom: 80px;">-->
<!--                    Remarks:-->
