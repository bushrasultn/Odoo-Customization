<!--                    ___________________-->
<!--                    <br>Applicant</br>-->
<!--                </p>-->
<!--                <p style="display: inline-block; width: 150px; margin-right: 50px; text-align: center;font-size: 16px;">-->
<!--                    ___________________-->
<!--                    <br>HOD</br>-->
<!--                </p>-->
<!--                <p style="display: inline-block; width: 150px; margin-right: 50px; text-align: center;font-size: 16px;">-->
<!--                    ___________________-->
<!--                    <br>HR</br>-->
<!--                </p>-->
<!--                <p style="display: inline-block; width: 150px; margin-right: 50px; text-align: center;font-size: 16px;">-->
<!--                    ___________________-->
<!--                    <br>Approved By</br>-->
<!--                </p>-->
<!--                <p style="display: inline-block; width: 150px; text-align: center;font-size: 16px;">-->
<!--                    ___________________-->
<!--                    <br>Treasury</br>-->
<!--                </p>-->
                <!--  Print Information Section  -->
                <div style="display: flex; align-items: center; margin-top: 10px; font-size: 12px;">
                    <span>
                        Print By:
                        <span t-esc="request.env.user.name"/>
                    </span>
                    <span style="margin-left: 30px;">
                        Print Date/Time:
                        <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M')"/>
                    </span>
                </div>
            </div>
        </template>
    </data>
</odoo>