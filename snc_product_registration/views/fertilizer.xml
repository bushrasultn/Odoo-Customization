<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_fertilizer_reg_form" model="ir.ui.view">
            <field name="name">fertilizer.reg.form</field>
            <field name="model">fertilizer.reg</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar"
                               options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="sequence" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="product"/>
                                <field name="brand"/>
                                <field name="composition"/>
                                <field name="undertaking"/>
                                <field name="reg_type"/>
                                <field name="reg_no"/>
                                <field name="reg_date"/>
                            </group>
                            <group>
                                <field name="expiry_date"/>
                                <field name="apply_date"/>
                                <field name="rcv_date"/>
                                <field name="province"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Note">
                                <field name="note"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="view_fertilizer_reg_tree" model="ir.ui.view">
            <field name="name">fertilizer.reg.tree</field>
            <field name="model">fertilizer.reg</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="sequence" string="Name" width="150"/>
                    <field name="product" width="100"/>
                    <field name="brand" width="60"/>
                    <field name="reg_no" width="90"/>
                    <field name="composition" optional="Hide"/>
                    <field name="reg_type" optional="Hide"/>
                    <field name="province" optional="Hide"/>
                    <field name="undertaking" optional="Hide"/>
                    <field name="reg_date" width="200"/>
                    <field name="expiry_date" width="200"/>
                    <field name="apply_date" optional="Hide" width="200"/>
                    <field name="renewal_date" width="200"/>
                    <field name="rcv_date" optional="Hide" width="200"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'applied' or state == 'renewal'"
                           decoration-danger="state  == 'expired'"
                           decoration-success=" state == 'registered'"/>
                </tree>
            </field>
        </record>
        <record id="action_fertilizer_reg" model="ir.actions.act_window">
            <field name="name">Fertilizer Registration</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">fertilizer.reg</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_fertilizer_reg"
                  name="Fertilizers"
                  parent="menu_reg_category"
                  action="action_fertilizer_reg"
                  sequence="2"/>
    </data>
</odoo>
