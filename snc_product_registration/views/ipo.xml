<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_ipo_reg_form" model="ir.ui.view">
        <field name="name">ipo.reg.form</field>
        <field name="model">ipo.reg</field>
        <field name="arch" type="xml">
            <form string="Ipo Registration">
                <header>
                    <field name="state" widget="statusbar"
                           options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="sequence" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="product"/>
                            <field name="brand"/>
                            <field name="undertaking"/>
                            <field name="ipo_class" options="{'no_create': True}"/>
                            <field name="apply_date"/>
                            <field name="description"/>
                            <field name="stages" options="{'no_create': True}"/>
                            <field name="reg_no"/>
                        </group>
                        <group>
                            <field name="payment_date"/>
                            <field name="reg_date"/>
                            <field name="sealed_date"/>
                            <field name="expiry_date"/>
                            <field name="sent_date"/>
                            <field name="rcv_date"/>
                            <field name="next_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Note">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_ipo_reg_tree" model="ir.ui.view">
        <field name="name">ipo.reg.tree</field>
        <field name="model">ipo.reg</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" string="Name" width="150"/>
                <field name="product" width="100"/>
                <field name="brand" width="100"/>
                <field name="undertaking" width="100"/>
                <field name="reg_no" width="100"/>
                <field name="reg_date" width="100"/>
                <field name="sealed_date" width="100"/>
                <field name="sent_date" optional="Hide" width="100"/>
                <field name="rcv_date" optional="Hide" width="100"/>
                <field name="next_date" optional="Hide" width="100"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'applied' or state == 'renewal'"
                       decoration-danger="state  == 'expired'"
                       decoration-success=" state == 'registered'"/>
            </tree>
        </field>
    </record>
    <record id="action_ipo_reg" model="ir.actions.act_window">
        <field name="name">IPO Registrations</field>
        <field name="res_model">ipo.reg</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_ipo_reg_tree"/>
    </record>

    <menuitem id="menu_ipo_reg"
              name="IPO Registration"
              parent="menu_register_root"
              action="action_ipo_reg"
              sequence="3"/>
</odoo>
