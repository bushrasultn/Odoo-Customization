<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--  Form view of Pesticides Registration  -->
        <record id="view_pesticides_reg_form" model="ir.ui.view">
            <field name="name">pesticides.reg.form</field>
            <field name="model">pesticides.reg</field>
            <field name="arch" type="xml">
                <form>

                    <header>
                        <field name="state" widget="statusbar"
                               options="{'clickable': '1'}"/>
                    </header>

                    <sheet>

                        <div class="oe_title">
                            <h1>
                                <field name="name" force_save="True" readonly="True"/>
                            </h1>
                        </div>

                        <group>
                            <group>
                                <field name="sr_no"/>
                                <field name="ref_no"/>
                                <field name="product"/>
                                <field name="generic"/>
                                <field name="brand"/>
                                <field name="undertaking"/>
                                <field name="form_type"/>
                                <field name="category"/>
                                <field name="province"/>
                            </group>
                            <group>
                                <field name="alert" invisible="1"/>
                                <field name="reg_date"/>
                                <field name="expiry_date"/>
                                <field name="apply_date"/>
                                <field name="renewal_date"/>
                                <field name="exp_agent"/>
                                <field name="ref_agent"/>
                                <field name="country"/>
                                <field name="crops"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Formulation">
                                <field name="formulation_lines">
                                    <tree editable="bottom">
                                        <field name="formulation" width="200"/>
                                        <field name="mnf_name" width="200"/>
                                        <field name="license_no" width="200"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Technical %">
                                <field name="technical_lines">
                                    <tree editable="bottom">
                                        <field name="technical" width="200"/>
                                        <field name="mnf_name" width="200"/>
                                        <field name="license_no" width="200"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Note">
                                <field name="note"/>
                            </page>
                        </notebook>

                    </sheet>

                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>

                </form>
            </field>
        </record>

        <!--  Tree View of Pesticides Registration  -->

        <record id="view_pesticides_reg_tree" model="ir.ui.view">
            <field name="name">pesticides.reg.tree</field>
            <field name="model">pesticides.reg</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" optional="Hide"/>
                    <field name="sr_no"/>
                    <field name="ref_no"/>
                    <field name="product"/>
                    <field name="generic"/>
                    <field name="brand"/>
                    <field name="form_type"/>
                    <field name="category" optional="Hide"/>
                    <field name="undertaking"/>
                    <field name="reg_date" optional="Hide"/>
                    <field name="expiry_date"/>
                    <field name="country" optional="Hide"/>
                    <field name="province" optional="Hide"/>
                    <field name="exp_agent" optional="Hide"/>
                    <field name="ref_agent" optional="Hide"/>
                    <field name="apply_date" optional="Hide"/>
                    <field name="renewal_date" optional="Hide"/>
                    <field name="crops" optional="Hide"/>
                    <field name="alert" widget="badge"
                           decoration-warning="alert  == 'imp'"
                           decoration-danger=" alert == 'urgent'"/>
                    <field name="state" widget="badge"
                           decoration-info="state == 'applied' or state == 'renewal'"
                           decoration-danger="state  == 'expired'"
                           decoration-success=" state == 'registered'"/>
                </tree>
            </field>
        </record>
        <record id="action_pesticides_reg" model="ir.actions.act_window">
            <field name="name">Pesticides Registration</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">pesticides.reg</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_pesticides"
                  name="Pesticides"
                  parent="menu_reg_category"
                  action="action_pesticides_reg"
                  sequence="1"/>
    </data>
</odoo>
