<data>
    <template id="report_analysis_report">
        <t t-call="web.html_container">
            <t t-call="snc_quality_control.custom_header"/>
            <t t-call="web.external_layout">
                <div class="page">
                    <t t-foreach="docs" t-as="o"/>
                    <style>
                        /* Scoped Styles for the Report Tables */
                        .report-tables .table {
                        }

                        .report-tables .table td,
                        .report-tables .table th {
                        border: none;
                        background-color: transparent;
                        }

                        .report-tables .fw-bold {
                        font-weight: bold;
                        }

                        .report-tables h3 {
                        <!--                        font-size: 16px; /* Decreased font size for h3 */-->
                        color: black;
                        }

                        .report-tables .first_header_font {
                        text-align: left;
                        }

                        /* Prevent date wrapping */
                        .report-tables .date-span {
                        display: inline-block;
                        max-width: 100%;
                        white-space: nowrap;
                        }
                        /* Align label and record pairs inline */
                        .report-tables .inline-row td {
                        padding: 0 10px 0 0; /* Space between label and record */
                        white-space: nowrap;
                        }

                        .report-tables .inline-row .label {
                        font-weight: bold;
                        width: 40%; /* Label takes up 40% of the row */
                        }

                        .report-tables .inline-row .value {
                        width: 60%; /* Value takes up the remaining 60% of the row */
                        }

                        /* Flex layout with no wrapping */
                        .report-tables .dates-inline {
                        display: flex;
                        flex-wrap: nowrap;
                        gap: 20px;
                        align-items: center; /* Vertically center the label and value */
                        }
                    </style>
                    <h2 style="text-align: center; margin-top: 10px; margin-bottom: 10px; color: black; font-size:24px">
                        Sample Analysis Report(FG)
                    </h2>
                    <div class="report-tables" style="margin-bottom:20px;">
                        <div class="row">
                            <div class="col-4">
                                <table class="table table-sm table-borderless">
                                    <tr class="first_header_font">
                                        <td class="fw-bold" style="white-space:nowrap;font-size: 18px;">
                                            Requested By:
                                        </td>
                                        <td class="fw-bold" style="font-size: 18px;white-space:nowrap;">
                                            <span t-esc="o.user_id.name"/>
                                        </td>
                                    </tr>
                                    <tr class="first_header_font">
                                        <td class="fw-bold" style="white-space:nowrap;font-size: 18px;">
                                            Manufacturing Order:
                                        </td>
                                        <td class="fw-bold" style="font-size: 18px;">
                                            <span t-esc="o.production_id.name"/>
                                        </td>
                                    </tr>
                                    <tr class="first_header_font">
                                        <td class="fw-bold" style="font-size: 18px;">
                                            Product:
                                        </td>
                                        <td class="fw-bold " style="font-size: 18px;">
                                            <span class="date-span" t-esc="o.product_id.name"/>
                                        </td>
                                    </tr>
                                    <tr class="first_header_font">
                                        <td class="fw-bold" style="font-size: 18px;">Batch No:</td>
                                        <td class="fw-bold" style="font-size: 18px;">
                                            <span t-esc="o.lot_producing_id.name or ''"/>
                                        </td>
                                    </tr>
                                    <tr class="first_header_font">
                                        <td class="fw-bold" style="font-size: 18px;">Vehicle No:</td>
                                        <td class="fw-bold" style="font-size: 18px;">
                                            <span t-esc="o.vehicle_no"/>
                                        </td>
                                    </tr>
                                    <tr class="first_header_font">
                                        <td class="fw-bold" style="white-space:nowrap;font-size: 18px;">Sample
                                            Volume:
                                        </td>
                                        <td class="fw-bold" style="font-size: 18px;">
                                        </td>
                                    </tr>
                                    <tr class="first_header_font dates-inline">
                                        <td class="label fw-bold" style="font-size: 18px;white-space:nowrap;">Sample
                                            Analysis Date:
                                        </td>
                                        <td class="value fw-bold" style="font-size: 18px;">
                                            <t t-if='o.analysis'>
                                                <span style="white-space:nowrap;"
                                                      t-esc="o.analysis.strftime('%d-%m-%y')"/>
                                            </t>
                                        </td>
                                    </tr>
                                    <tr class="first-header-font">
                                        <td class="fw-bold" style="white-space:nowrap;">Partner Name:</td>
                                        <td class="fw-bold" style="font-size: 16px;white-space:nowrap;">
                                            <span t-esc="o.partner_id.name"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>

                            <div class="col-3"/>

                            <!-- Second Table -->
                            <div class="col-2 offset-2">
                                <table class="table table-sm table-borderless">
                                    <tr class="first_header_font dates-inline">
                                        <td class="label fw-bold" style="font-size: 18px;">Mfg.Date:</td>
                                        <td class="value fw-bold" style="font-size: 15px;">
                                            <t t-if='o.mfg'>
                                                <span style="white-space:nowrap;"
                                                      t-esc="o.mfg.strftime('%d-%m-%y')"/>
                                            </t>
                                        </td>
                                    </tr>
                                    <tr class="first_header_font dates-inline">
                                        <td class="label fw-bold" style="font-size: 18px;">Exp.Date:</td>
                                        <td class="value fw-bold" style="font-size: 15px;">
                                            <t t-if='o.exp'>
                                                <span style="white-space:nowrap;"
                                                      t-esc="o.exp.strftime('%d-%m-%y')"/>
                                            </t>
                                        </td>
                                    </tr>
                                    <tr class="first_header_font dates-inline"
                                        style="display: flex; align-items: center;">
                                        <td class="label fw-bold"
                                            style="white-space: nowrap;font-size: 18px;">
                                            Receiving Date:
                                        </td>
                                        <td class="value fw-bold"
                                            style="font-size: 15px; white-space: nowrap;">
                                            <t t-if='o.receive'>
                                                <span style="white-space:nowrap;"
                                                      t-esc="o.receive.strftime('%d-%m-%y')"/>
                                            </t>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="label fw-bold"
                                            style="white-space: nowrap;font-size: 18px;">
                                            Report Issue Date:
                                        </td>
                                        <td class="value fw-bold" style="font-size: 15px; white-space: nowrap;">
                                            <t t-if='o.report'>
                                                <span style="white-space:nowrap;" t-esc="o.report.strftime('%d-%m-%y')"/>
                                            </t>
                                        </td>
                                    </tr>
                                    <tr class="first_header_font">
                                        <td class="fw-bold" style="font-size: 18px;">Humidity %:</td>
                                        <td class="fw-bold" style="font-size: 16px;">
                                            <span t-esc="o.humidity"/>
                                        </td>
                                    </tr>
                                    <tr class="first_header_font">
                                        <td class="fw-bold" style="white-space:nowrap; font-size: 18px;">Temperature
                                            (°C):
                                        </td>
                                        <td class="fw-bold" style="font-size: 16px;">
                                            <span t-esc="o.temperature"/>
                                        </td>
                                    </tr>
                                    <tr class="first_header_font">
                                        <td class="fw-bold" style="white-space:nowrap; font-size: 18px;">Quantity:
                                        </td>
                                        <td class="fw-bold" style="font-size: 16px;">
                                            <span t-esc="o.quantity"
                                                  t-options="{'widget': 'float', 'precision': 1, 'thousands_sep': ''}"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div style="margin-bottom: 0px;"/>
                    <h3 style="text-align: left; margin-top: 10; font-size: 18px; font-weight: bold; text-decoration: underline;">
                        TEST RESULT:
                    </h3>
                    <div class='row' style="margin-top: 20px;">
                        <span t-esc="o.note"/>
                    </div>
                </div>
            </t>
        </t>
    </template>
</data>
