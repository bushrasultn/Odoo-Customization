<odoo>
    <data>
        <template id="inspection_report">
            <t t-call="web.html_container">
                <t t-call="snc_quality_control.inspection_footer"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-foreach="docs" t-as="o"/>
                        <h2 style="text-align: center; margin: 20px 0; padding-top: 20px; font-size: 18px; font-weight: bold;color: black;">
                            Goods Inspection Report (GIR)
                        </h2>
                        <style>
                            .custom-report-tables .table { font-size: 13px; }
                            .custom-report-tables .table td, .custom-report-tables .table th { border: none;
                            background-color: transparent; }
                            .custom-report-tables .fw-bold { font-weight: bold; }
                            .custom-report-tables .first-header-font { text-align: left; }
                        </style>
                        <div class="custom-report-tables">
                            <div class="row">
                                <div class="col-4">
                                    <table class="table table-sm table-borderless">
                                        <tr class="first-header-font">
                                            <td class="fw-bold" style="white-space:nowrap;">Customer Name:</td>
                                            <td class="fw-bold" style="font-size: 13px;white-space:nowrap;">
                                                <span t-esc="o.partner_id.name"/>
                                            </td>
                                        </tr>
                                        <tr class="first-header-font">
                                            <td class="fw-bold" style="white-space:nowrap;">Stock Picking:</td>
                                            <td class="fw-bold" style="font-size: 13px;">
                                                <span t-esc="o.picking_id.name"/>
                                            </td>
                                        </tr>
                                        <tr class="first-header-font">
                                            <td class="fw-bold" style="white-space:nowrap;">PO#:</td>
                                            <td class="fw-bold" style="font-size: 13px;">
                                                <span t-esc="o.origin"/>
                                            </td>
                                            <tr class="first-header-font">
                                                <td class="fw-bold" style="white-space:nowrap;">Product Name:</td>
                                                <td class="fw-bold" style="font-size: 13px;">
                                                    <span t-esc="o.product_id.name"/>
                                                </td>
                                            </tr>
                                        </tr>
                                        <!--                                            FETCHING THE QUANTITY FROM PURCHASE ORDER-->
                                        <t t-foreach="docs" t-as="o">
                                            <t t-set="purchase_order"
                                               t-value="env['purchase.order'].search([('name', '=', o.origin)], limit=1)"/>
                                            <t t-if="purchase_order">
                                                <t t-set="product_line"
                                                   t-value="purchase_order.order_line.filtered(lambda line: line.product_id == o.product_id)"/>
                                                <t t-if="product_line">
                                                    <tr class="first-header-font">
                                                        <td class="fw-bold" style="white-space:nowrap;">Quantity
                                                            Ordered
                                                        </td>
                                                        <td class="fw-bold" style="font-size: 13px;">
                                                            <span t-esc="product_line.product_qty"
                                                                  t-options="{'widget': 'float', 'precision': 1, 'thousands_sep': ''}"/>
                                                        </td>
                                                    </tr>
                                                    <tr class="first-header-font">
                                                        <td class="fw-bold" style="white-space:nowrap;">Quantity
                                                            Received
                                                        </td>
                                                        <td class="fw-bold" style="font-size: 13px;">
                                                            <span t-esc="product_line.qty_received"
                                                                  t-options="{'widget': 'float', 'precision': 1, 'thousands_sep': ''}"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </t>
                                        </t>
                                    </table>
                                </div>
                                <div class="col-2"/>
                                <div class="col-2 offset-2">
                                    <table class="table table-sm table-borderless">
                                        <tr class="first-header-font">
                                            <td class="fw-bold" style="font-size: 13px; text-align: left">Mfg
                                                Date:
                                            </td>
                                            <td class="fw-bold" style="font-size: 13px; text-align: left">
                                                <t t-if='o.mfg'>
                                                    <span style="white-space:nowrap;"
                                                          t-esc="o.mfg.strftime('%d-%m-%y')"/>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr class="first-header-font">
                                            <td class="fw-bold" style="font-size: 13px; text-align: left">Expiry
                                                Date:
                                            </td>
                                            <td class="fw-bold" style="font-size: 13px; text-align: left">
                                                <t t-if='o.exp'>
                                                    <span style="white-space:nowrap;"
                                                          t-esc="o.exp.strftime('%d-%m-%y')"/>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr class="first-header-font">
                                            <td class="fw-bold" style="white-space:nowrap;">Security#:</td>
                                            <td class="fw-bold" style="font-size: 13px;">
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="row" style="margin-top:30px;">
                            <span t-esc="o.note"/>
                        </div>
                        <div style="margin-top: 10px;">
                            Remarks:
                            <span style="font-size: 12px;" t-field="o.additional_note"/>
                        </div>
                    </div>
                </t>
            </t>
        </template>
<!--..............................................INSPECTION HEADER & FOOTER................................-->
        <template id="inspection_footer">
            <t t-set="company" t-value="res_company"/>
            <div class="header" style="text-align: center; margin-bottom: 20px;">
                <div class="row" style="border-bottom: 1px solid #000; padding-bottom: 10px;">
                    <div class="col-2">
                        <t t-set="logo" t-value="company.logo and company.logo.decode('utf-8') or ''"/>
                        <img t-att-src="'data:image/png;base64,' + logo" style="max-height: 80px;" alt="Company Logo"/>
                    </div>
                    <div class="col-8" style="text-align: center;">
                        <p style="font-size: 18px; font-weight: bold; margin: 0;">
                            <t t-esc="company.name"/>
                        </p>
                        <p style="margin: 0;">
                            <t t-esc="company.partner_id.street"/>
                        </p>
                    </div>
                </div>
            </div>
            <div class="footer" style="text-align: left; margin-top: 20px; white-space: nowrap;">
                <p class ="fw-bold" style="display: inline-block; width: 250px; margin-right: 250px; text-align: center;font-size: 16px;">
                    ___________________
                    <br>Prepared By</br>
                </p>
                <p class ="fw-bold" style="display: inline-block; width: 280px; margin-right: 280px; text-align: center;font-size: 16px;">
                    ___________________
                    <br>Verified By</br>
                </p>
                <p class ="fw-bold" style="display: inline-block; width: 280px; margin-right: 320px; text-align: center;font-size: 16px;">
                    ___________________
                    <br>Inspected By</br>
                </p>
                <div style="display: flex; align-items: center; margin-top: 10px; font-size: 12px;">
                    <span>
                        Print By:
                        <span t-esc="request.env.user.short_code"/>
                    </span>
                    <span style="margin-left: 30px;">
                        Post By:
                        <t t-esc="docs.write_uid.short_code"/>
                    </span>
                    <span style="margin-left: 30px;">
                        Print Date/Time:
                        <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M')"/>
                    </span>
                </div>
            </div>
        </template>
    </data>
</odoo>
