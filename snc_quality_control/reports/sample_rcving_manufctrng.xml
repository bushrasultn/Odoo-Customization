<odoo>
    <data>
        <!-- Template for Manufacturing Report -->
        <template id="report_manufacturing_report">
            <t t-call="web.html_container">
                <t t-call="snc_quality_control.receiving_temp"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-foreach="docs" t-as="o"/>
                        <style>
                            /* Scoped Styles for the Report Tables */
                            .report-tables .table {
                            font-size: 16px; /* Decreased font size */
                            }

                            .report-tables .table td,
                            .report-tables .table th {
                            border: none;
                            background-color: transparent;
                            }

                            .report-tables .fw-bold {
                            font-weight: bold;
                            }

                            .report-tables h3 {
                            font-size: 16px; /* Decreased font size for h3 */
                            color: black;
                            }

                            .report-tables .first_header_font {
                            text-align: left;
                            }

                            /* Prevent date wrapping */
                            .report-tables .date-span {
                            display: inline-block;
                            max-width: 200%;
                            white-space: nowrap;
                            }

                            /* Align label and record pairs inline */
                            .report-tables .inline-row td {
                            padding: 0 10px 0 0; /* Space between label and record */
                            white-space: nowrap;
                            }

                            .report-tables .inline-row .label {
                            font-weight: bold;
                            width: 40%; /* Label takes up 40% of the row */
                            }

                            .report-tables .inline-row .value {
                            width: 60%; /* Value takes up the remaining 60% of the row */
                            }

                            /* Flex layout with no wrapping */
                            .report-tables .dates-inline {
                            display: flex;
                            flex-wrap: nowrap;
                            gap: 20px;
                            align-items: center; /* Vertically center the label and value */
                            }
                        </style>
                        <h2 style="text-align: center; margin-top: 10px; margin-bottom: 10px; color: black; font-size:20px">
                            Sample Analysis Request
                        </h2>
                        <div class="report-tables" style="margin-top:20px">
                            <div class="row">
                                <div class="col-4">
                                    <table class="table table-sm table-borderless">
                                        <tr class="first_header_font">
                                            <td class="fw-bold">
                                                Requested By:
                                            </td>
                                            <td class="fw-bold product-name" style="font-size: 15px;">
                                                <span class="date-span" t-esc="o.user_id.name"/>
                                            </td>
                                        </tr>
                                        <tr class="first_header_font">
                                            <td class="fw-bold">
                                                Product:
                                            </td>
                                            <td class="fw-bold" style="font-size: 15px;">
                                                <span class="date-span" t-esc="o.product_id.name"/>
                                            </td>
                                        </tr>
                                        <tr class="first_header_font">
                                            <td class="fw-bold" style="white-space: nowrap;">No of Test Items:</td>
                                            <td class="fw-bold" style="font-size: 15px;">
                                            </td>
                                        </tr>
                                        <tr class="first_header_font">
                                            <td class="fw-bold" style="white-space: nowrap;">Temperature (°C):</td>
                                            <td class="fw-bold" style="font-size: 15px;">
                                                <span t-esc="o.temperature"/>
                                            </td>
                                        </tr>
                                        <tr class="first_header_font">
                                            <td class="fw-bold">Humidity %:</td>
                                            <td class="fw-bold" style="font-size: 15px;">
                                                <span t-esc="o.humidity"/>
                                            </td>
                                        </tr>
                                        <tr class="first_header_font dates-inline"
                                            style="display: flex; align-items: center;">
                                            <td class="label fw-bold"
                                                style="white-space: nowrap; margin-right: 10px;">
                                                Sample Testing Date:
                                            </td>
                                            <td class="value fw-bold"
                                                style="font-size: 15px; white-space: nowrap; margin-right: 10px;">
                                                <t t-if='o.analysis'>
                                                    <span style="white-space:nowrap;"
                                                          t-esc="o.analysis.strftime('%d-%m-%y')"/>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr class="first-header-font">
                                            <td class="fw-bold" style="white-space:nowrap;font-size: 18px;">Partner
                                                Name:
                                            </td>
                                            <td class="fw-bold" style="font-size: 16px;white-space:nowrap;">
                                                <span t-esc="o.partner_id.name"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>

                                <div class="col-3"/>

                                <!-- Second Table -->
                                <div class="col-2 offset-2">
                                    <table class="table table-sm table-borderless">
                                        <tr class="first_header_font">
                                            <td class="fw-bold">Batch No:</td>
                                            <td class="fw-bold" style="font-size: 15px;">
                                                <!-- <span t-esc="o.batch_no or ''"/> -->
                                            </td>
                                        </tr>
                                        <tr class="first_header_font dates-inline"
                                            style="display: flex; align-items: center;">
                                            <td class="label fw-bold"
                                                style="white-space: nowrap">
                                                Receiving Date:
                                            </td>
                                            <td class="value fw-bold"
                                                style="font-size: 15px; white-space: nowrap">
                                                <t t-if='o.receive'>
                                                    <span style="white-space:nowrap;"
                                                          t-esc="o.receive.strftime('%d-%m-%y')"/>
                                                </t>
                                            </td>
                                            <tr>
                                                <td class="label fw-bold"
                                                    style="white-space: nowrap; margin-right: 10px;">
                                                    Report Issue Date:
                                                </td>
                                                <td class="value fw-bold"
                                                    style="font-size: 15px; white-space: nowrap;">
                                                    <t t-if='o.report'>
                                                        <span style="white-space:nowrap;"
                                                              t-esc="o.report.strftime('%d-%m-%y')"/>
                                                    </t>
                                                </td>
                                            </tr>
                                            <tr class="first_header_font dates-inline">
                                                <td class="label fw-bold" style="font-size: 18px;">Mfg.Date:</td>
                                                <td class="value fw-bold" style="font-size: 16px;">
                                                    <t t-if='o.mfg'>
                                                        <span style="white-space:nowrap;"
                                                              t-esc="o.mfg.strftime('%d-%m-%y')"/>
                                                    </t>
                                                </td>
                                            </tr>
                                            <tr class="first_header_font dates-inline">
                                                <td class="label fw-bold" style="font-size: 18px;">Exp.Date:</td>
                                                <td class="value fw-bold" style="font-size: 16px;">
                                                    <t t-if='o.exp'>
                                                        <span style="white-space:nowrap;"
                                                              t-esc="o.exp.strftime('%d-%m-%y')"/>
                                                    </t>
                                                </td>
                                            </tr>
                                        </tr>
                                        <tr class="first_header_font">
                                            <td class="fw-bold" style="white-space:nowrap; font-size: 18px;">
                                                Quantity:
                                            </td>
                                            <td class="fw-bold" style="font-size: 18px;">
                                                <span t-esc="o.quantity"
                                                      t-options="{'widget': 'float', 'precision': 1, 'thousands_sep': ''}"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <table class="table table-striped"
                               style="border-collapse: collapse; width: 100%;margin-top:20px;margin-bottom:20px">
                            <tr>
                                <td style="border:1px solid black; padding: 8px; width: 8%; text-align: center; font-weight: bold;">
                                    Sr. No.
                                </td>
                                <td style="border: 1px solid black; padding: 8px; width: 50%; text-align: center; font-weight: bold;">
                                    Details of Test Required
                                </td>
                                <td style="border: 1px solid black; padding: 8px; width: 50%; text-align: center; font-weight: bold;">
                                    Method to be used
                                    <br>(As Per Tolerance Limit)</br>
                                </td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid black; padding: 8px;">1.</td>
                                <td style="border: 1px solid black; padding: 8px;"/>
                                <td style="border: 1px solid black; padding: 8px;"/>
                            </tr>
                            <tr>
                                <td style="border: 1px solid black; padding: 8px;">2.</td>
                                <td style="border: 1px solid black; padding: 8px;"/>
                                <td style="border: 1px solid black; padding: 8px;"/>
                            </tr>
                            <tr>
                                <td style="border: 1px solid black; padding: 8px;">3.</td>
                                <td style="border: 1px solid black; padding: 8px;"/>
                                <td style="border: 1px solid black; padding: 8px;"/>
                            </tr>
                            <tr>
                                <td style="border: 1px solid black; padding: 8px;">4.</td>
                                <td style="border: 1px solid black; padding: 8px;"/>
                                <td style="border: 1px solid black; padding: 8px;"/>
                            </tr>
                            <tr>
                                <td style="border: 1px solid black; padding: 8px;">5.</td>
                                <td style="border: 1px solid black; padding: 8px;"/>
                                <td style="border: 1px solid black; padding: 8px;"/>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </template>
        <!--...............................SAMPLE ANALYSIS HEADER & FOOTER.......................................-->
        <template id="receiving_temp">
            <t t-set="company" t-value="res_company"/>
            <div class="header">
                <table class="table table-sm table-borderless" style="border: 1px solid white;">
                    <tr>
                        <!-- Logo Section -->
                        <td style="width: 30%; text-align: left; vertical-align: middle;">
                            <t t-set="logo" t-value="company.logo and company.logo.decode('utf-8') or ''"/>
                            <img t-att-src="'data:image/png;base64,' + logo"
                                 style="max-height: 80px; margin-top: 0px; margin-bottom: 0px;"/>
                        </td>

                        <!-- Company Name and Address Section -->
                        <td style="width: 40%; vertical-align: middle;">
                            <p class="fw-bold"
                               style="font-size: 24px; text-align: center; margin-top: 0px; margin-bottom: 0px;"
                               t-esc="company.name"/>
                            <p style="margin-top: 0px; margin-bottom: 0px; text-align: center;">
                                <t t-esc="company.partner_id.street"/>
                            </p>
                        </td>

                        <!-- Document Info Section -->
                        <td style="width: 30%; text-align: right; vertical-align: middle;">
                            <p style="text-align: left; border: none; margin-top: 0px; margin-bottom: 0px; font-size: 14px;">
                                Doc ID
                            </p>
                            <p style="text-align: left; border: none; margin-top: 0px; margin-bottom: 0px; font-size: 14px;">
                                Issue Date
                            </p>
                            <p style="text-align: left; border: none; margin-top: 0px; margin-bottom: 0px; font-size: 14px;">
                                Rev.#
                            </p>
                        </td>
                    </tr>
                </table>

                <!-- Underline Section -->
                <div style="margin-top: 0px;"></div>
                <span style="display: block; text-decoration: underline; margin: 0 auto; width: 100%;">
                    ________________________________________________________________________________________________________________________
                </span>
            </div>

            <div class="footer">
                <div style="margin-top: 50px;"></div>
                <div style="text-align: left; margin-top: 0; font-size: 12px;">
                    <p>The customer requires confirmation statement on "Test Report" (Yes/No):</p>
                    <p>According to decision rule.</p>
                    <div class="col-2" style="font-size: 10px;">SAMPLE QTY (IN TR/KC):</div>
                    <div class="col-10" style="font-weight: bold; font-size: 10px;">
                        <div style="border-bottom: 1px solid black; width: 120%; display: inline-block;"></div>
                    </div>
                </div>

                <p style="display: inline-block; margin-top: 20px; margin-right: 300px; font-size: 14px;">
                    Requested by:_______________
                </p>
                <p style="display: inline-block; margin-left: 80px; font-size: 14px;">
                    Received by:_______________
                </p>

                <!-- Bullet point list for uncertainty statement -->
                <ul style="list-style-type: disc; margin-left: 20px; font-size: 12px; margin: 5px 0; padding-left: 20px; line-height: 1.2;">
                    <li>If the uncertainty of the sample tested is outside regulatory/tolerance limits, the sample will
                        be declared UNFIT.
                    </li>
                </ul>

                <!-- Print info -->
                <div style="display: flex; align-items: center; margin: 0 0 2px; font-size: 12px;">
                    <span>Print By:
                        <span t-esc="request.env.user.name"/>
                    </span>
                    <span style="margin-left: 30px;">Print Date/Time:
                        <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M')"/>
                    </span>
                </div>
            </div>
        </template>
    </data>
</odoo>
