<odoo>
    <data>
        <template id="report_seed_report">
            <t t-call="web.html_container">
                <t t-call="snc_quality_control.seed_temp"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-foreach="docs" t-as="o"/>
                        <style>
                            /* Scoped Styles for the Report Tables */
                            .report-tables .table {
                            <!--                            font-size: 16px; /* Decreased font size */-->
                            }

                            .report-tables .table td,
                            .report-tables .table th {
                            border: none;
                            background-color: transparent;
                            }

                            .report-tables .fw-bold {
                            font-weight: bold;
                            }

                            .report-tables h3 {
                            <!--                            font-size: 16px; /* Decreased font size for h3 */-->
                            color: black;
                            }

                            .report-tables .first_header_font {
                            text-align: left;
                            }

                            /* Prevent date wrapping */
                            .report-tables .date-span {
                            display: inline-block;
                            max-width: 100%;
                            white-space: nowrap;
                            }
                            /* Align label and record pairs inline */
                            .report-tables .inline-row td {
                            padding: 0 10px 0 0; /* Space between label and record */
                            white-space: nowrap;
                            }

                            .report-tables .inline-row .label {
                            font-weight: bold;
                            width: 40%; /* Label takes up 40% of the row */
                            }

                            .report-tables .inline-row .value {
                            width: 60%; /* Value takes up the remaining 60% of the row */
                            }

                            /* Flex layout with no wrapping */
                            .report-tables .dates-inline {
                            display: flex;
                            flex-wrap: nowrap;
                            gap: 20px;
                            align-items: center; /* Vertically center the label and value */
                            }
                        </style>

                        <h2 style="text-align: center;margin-top:0px;margin-bottom:0px;color: black;font-size: 30px">
                            Seed Analysis
                            Report
                        </h2>
                        <div class="report-tables">
                            <div class="row">
                                <!-- First Table -->
                                <div class="col-4">
                                    <table class="table table-sm table-borderless">
                                        <tr class="first_header_font">
                                            <td class="fw-bold" style="white-space:nowrap;font-size: 20px">
                                                Picking Order:
                                            </td>
                                            <td class="fw-bold" style="font-size: 20px;white-space:nowrap;">
                                                <span t-esc="o.picking_id.name"/>
                                            </td>
                                        </tr>
                                        <tr class="first_header_font" style="font-size: 20px;">
                                            <td class="fw-bold">
                                                Crop:
                                            </td>
                                            <td class="fw-bold " style="font-size: 20px;">
                                                <span class="date-span" t-esc="o.crop"/>
                                            </td>
                                        </tr>
                                        <tr class="first_header_font">
                                            <td class="fw-bold" style="font-size: 20px;">Lot No:</td>
                                            <td class="fw-bold" style="font-size: 20px;">
                                                <!-- <span t-esc="o.batch_no or ''"/> -->
                                            </td>
                                        </tr>
                                        <tr class="first_header_font">
                                            <td class="fw-bold" style="font-size: 20px;">Method:</td>
                                            <td class="fw-bold" style="font-size: 20px;">
                                                <span t-esc="o.method"/>
                                            </td>
                                        </tr>
                                        <tr class="first_header_font">
                                            <td class="fw-bold" style="font-size: 20px;white-space:nowrap;">
                                                Temperature (°C):
                                            </td>
                                            <td class="fw-bold" style="font-size: 20px;">
                                                <span t-esc="o.temperature"/>

                                            </td>
                                        </tr>
                                        <tr class="first-header-font">
                                            <td class="fw-bold" style="white-space:nowrap;font-size: 18px;">Partner
                                                Name:
                                            </td>
                                            <td class="fw-bold" style="font-size: 16px;white-space:nowrap;">
                                                <span t-esc="o.partner_id.name"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>

                                <div class="col-3"/>

                                <!-- Second Table -->
                                <div class="col-2 offset-2">
                                    <table class="table table-sm table-borderless">
                                        <tr class="first_header_font dates-inline">
                                            <td class="label fw-bold" style="font-size: 18px;">Mfg.Date:</td>
                                            <td class="value fw-bold" style="font-size: 14px;">
                                                <t t-if='o.mfg'>
                                                    <span style="white-space:nowrap;"
                                                          t-esc="o.mfg.strftime('%d-%m-%y')"/>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr class="first_header_font dates-inline">
                                            <td class="label fw-bold" style="font-size: 18px;">Exp.Date:</td>
                                            <td class="value fw-bold" style="font-size: 14px;">
                                                <t t-if='o.exp'>
                                                    <span style="white-space:nowrap;"
                                                          t-esc="o.exp.strftime('%d-%m-%y')"/>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr class="first_header_font dates-inline"
                                            style="display: flex; align-items: center;">
                                            <td class="label fw-bold"
                                                style="white-space: nowrap;font-size:18px">
                                                Receiving Date:
                                            </td>
                                            <td class="value fw-bold"
                                                style="font-size: 14px; white-space: nowrap;">
                                                <t t-if='o.receive'>
                                                    <span style="white-space:nowrap;"
                                                          t-esc="o.receive.strftime('%d-%m-%y')"/>
                                                </t>
                                            </td>
                                            <tr>
                                                <td class="label fw-bold"
                                                    style="white-space: nowrap;font-size: 18px;">
                                                    Report Issue Date:
                                                </td>
                                                <td class="value fw-bold"
                                                    style="font-size: 14px; white-space: nowrap;">
                                                    <t t-if='o.report'>
                                                        <span style="white-space:nowrap;"
                                                              t-esc="o.report.strftime('%d-%m-%y')"/>
                                                    </t>
                                                </td>
                                            </tr>
                                        </tr>
                                        <tr class="first_header_font">
                                            <td class="fw-bold" style="font-size: 18px;">Humidity%:</td>
                                            <td class="fw-bold" style="font-size: 16px;">
                                                <span t-esc="o.humidity"/>
                                            </td>
                                        </tr>
                                        <tr class="first_header_font">
                                            <td class="fw-bold" style="white-space:nowrap; font-size: 18px;">
                                                Quantity:
                                            </td>
                                            <td class="fw-bold" style="font-size: 16px;">
                                                <span t-esc="o.quantity"
                                                      t-options="{'widget': 'float', 'precision': 1, 'thousands_sep': ''}"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="row" style="margin-top:30px;">
                            <span t-esc="o.note"/>
                        </div>
                    </div>
                </t>
            </t>
        </template>
        <!--        ..................................................SEED HEADER & FOOTER ......................................-->
        <template id="seed_temp">
            <t t-set="company" t-value="res_company"/>
            <div class="header" style="text-align: center; margin-bottom: 20px;">
                <div class="row" style="border-bottom: 1px solid #000; padding-bottom: 10px; margin-bottom: 10px;">
                    <div class="col-2">
                        <t t-set="logo" t-value="company.logo and company.logo.decode('utf-8') or ''"/>
                        <img t-att-src="'data:image/png;base64,' + logo" style="max-height: 80px;"/>
                    </div>
                    <div class="col-8">
                        <p style="font-size: 24px; font-weight: bold; margin: 0;text-align: center;">
                            <t t-esc="company.name"/>
                        </p>
                        <p style="margin: 0; text-align: center;">
                            <t t-esc="company.partner_id.street"/>
                        </p>
                    </div>
                </div>
            </div>
            <t t-raw="content"/>
            <div class="footer" style="text-align: left; margin-top: 100px; white-space: nowrap;">
                <p style="font-weight: bold; display: flex; align-items: center; margin-bottom: 50px;font-size: 20px;">
                    <b>Remarks:</b>
                    <span style="display: inline-block; border-bottom: 1px solid black; margin-left: 25px; width: 90%;"></span>
                </p>
                <p style="display: inline-block; width: 150px; margin-right: 150px;font-size: 20px;">
                    <b>Signature:_________________</b>
                </p>
                <p style="display: inline-block; width: 150px; margin-right: 150px;font-size: 20px;">
                    <b>Date:_________________</b>
                </p>
                <p style="display: inline-block; width: 150px; margin-right: 150px;font-size: 20px;">
                    <b>Reviewer:_________________</b>
                </p>
                <p style="display: inline-block; width: 150px; margin-right: 150px;font-size: 20px;">
                    <b>Date:_________________</b>
                </p>
                <div style="display: flex; align-items: center; margin: 0 0 2px; font-size: 18px;">
                    <span>Print By:
                        <span t-esc="request.env.user.name"/>
                    </span>
                    <span style="margin-left: 30px;">Print Date/Time:
                        <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M')"/>
                    </span>
                </div>
            </div>
        </template>
    </data>
</odoo>
