<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_toxic_report">
            <t t-call="web.html_container">
                <t t-call="snc_quality_control.toxic_temp"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-foreach="docs" t-as="o"/>
                        <style>
                            /* Scoped Styles for the Report Tables */
                            .report-tables .table {
                            font-size: 16px; /* Decreased font size */
                            }
                            .report-tables .table td,
                            .report-tables .table th {
                            border: none;
                            background-color: transparent;
                            }

                            .report-tables .fw-bold {
                            font-weight: bold;
                            }

                            .report-tables h3 {
                            font-size: 16px; /* Decreased font size for h3 */
                            color: black;
                            }

                            .report-tables .first_header_font {
                            text-align: left;
                            }

                            /* Prevent date wrapping */
                            .report-tables .date-span {
                            display: inline-block;
                            max-width: 100%;
                            white-space: nowrap;
                            }

                            /* Align label and record pairs inline */
                            .report-tables .inline-row td {
                            padding: 0 10px 0 0; /* Space between label and record */
                            white-space: nowrap;
                            }

                            .report-tables .inline-row .label {
                            font-weight: bold;
                            width: 40%; /* Label takes up 40% of the row */
                            }

                            .report-tables .inline-row .value {
                            width: 60%; /* Value takes up the remaining 60% of the row */
                            }

                            /* Flex layout with no wrapping */
                            .report-tables .dates-inline {
                            display: flex;
                            flex-wrap: nowrap;
                            gap: 20px;
                            align-items: center; /* Vertically center the label and value */
                            }

                            /* Remove space between two tables */
                            .no-space-between {
                            margin: 0; /* Remove the margin between columns */
                            padding: 0; /* Remove any padding */
                            }

                            /* Inline Test Animals Row */
                            .test-animals-row {
                            display: flex;
                            justify-content: space-between;
                            width: 100%;
                            }

                            .test-animals-row td {
                            padding-right: 1px; /* Space between columns */
                            text-align: left;
                            white-space: nowrap; /* Prevent wrapping of the text */
                            }

                            /* For readability, we remove border around table */
                            .report-tables .table, .report-tables td, .report-tables th {
                            border: none;
                            }

                            /* Ensuring No Wrapping for "Rabbits (M/F)", "Rats (M/F)", and "Albino (M/F)" */
                            .test-animals-row td {
                            white-space: nowrap;
                            }

                        </style>
                        <h2 style="text-align: center; margin-top: px; margin-bottom: px; color: black; font-size:20px">
                            Toxicity Test Report
                        </h2>

                        <div class="report-tables">
                            <div class="row">
                                <!-- First Table -->
                                <div class="col-4">
                                    <table class="table table-sm table-borderless">
                                        <tr class="first_header_font">
                                            <td class="fw-bold">
                                                Customer:
                                            </td>
                                            <td class="fw-bold" style="font-size: 15px;">
                                                <span class="date-span" t-esc="o.partner_id.name"/>
                                            </td>
                                        </tr>
                                        <tr class="first_header_font">
                                            <td class="fw-bold" style="white-space: nowrap;">Lab ID #:</td>
                                            <td class="fw-bold" style="font-size: 15px;white-space: nowrap;">
                                            </td>
                                        </tr>
                                        <tr class="first_header_font">
                                            <td class="fw-bold" style="white-space: nowrap;">Sample Name:</td>
                                            <td class="fw-bold" style="font-size: 15px;">
                                            </td>
                                        </tr>
                                    </table>
                                </div>

                                <div class="col-3 no-space-between"/>

                                <!-- Second Table -->
                                <div class="col-2 offset-1">
                                    <table class="table table-sm table-borderless">
                                        <tr class="first_header_font dates-inline"
                                            style="display: flex; align-items: center;">
                                            <td class="label fw-bold"
                                                style="white-space: nowrap; margin-right: 0px;">
                                                Receiving Date:
                                            </td>
                                            <td class="value fw-bold"
                                                style="font-size: 15px; white-space: nowrap; margin-right: 0px;">
                                                <t t-if='o.receive'>
                                                    <span style="white-space:nowrap;"
                                                          t-esc="o.receive.strftime('%d-%m-%y')"/>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr class="first_header_font">
                                            <td class="label fw-bold"
                                                style="white-space: nowrap; margin-right: 0px;">
                                                Report Issue Date:
                                            </td>
                                            <td class="value fw-bold" style="font-size: 15px; white-space: nowrap;">
                                                <t t-if='o.report'>
                                                    <span style="white-space:nowrap;"
                                                          t-esc="o.report.strftime('%d-%m-%y')"/>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr class="first_header_font">
                                            <td class="fw-bold">Observation Period:</td>
                                            <td class="fw-bold" style="font-size: 15px;">
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <!-- Methodology/Material Section -->
                            <h3 style="text-align: left; margin-top: 20px;margin-bottom: 10px; font-size: 16px; font-weight: bold;">
                                Methodology/Material:
                            </h3>
                            <h4 style="text-align: left; margin-top: 0; font-size: 14px;">
                                Tests were performed according to the Organization of Economic Cooperation and
                                Development (OECD) Guidelines.
                            </h4>
                            <div class="row" style="margin-top: 20;">
                                <!-- First Table -->
                                <div class="col-4">
                                    <table class="table table-sm table-borderless">
                                        <tr class="first_header_font">
                                            <td class="fw-bold" style="white-space: nowrap; font-size: 15px;">
                                                Physical Nature:
                                            </td>
                                        </tr>
                                        <tr class="first_header_font">
                                            <td class="fw-bold" style="font-size: 15px;">
                                                Start Date:
                                            </td>
                                            <td class="value fw-bold" style="font-size: 15px;">
                                                <t t-if='o.mfg'>
                                                    <span style="white-space:nowrap;"
                                                          t-esc="o.mfg.strftime('%d-%m-%y')"/>
                                                </t>
                                            </td>
                                        </tr>
                                        <tr class="first_header_font">
                                            <td class="fw-bold" style="font-size: 15px;">End Date:</td>
                                            <td class="value fw-bold" style="font-size: 15px;">
                                                <t t-if='o.exp'>
                                                    <span style="white-space:nowrap;"
                                                          t-esc="o.exp.strftime('%d-%m-%y')"/>
                                                </t>
                                            </td>
                                        </tr>
                                    </table>
                                </div>

                                <div class="col-3 no-space-between"/>

                                <!-- Second Table for Test Animals -->
                                <div class="col-2">
                                    <table class="table table-sm table-borderless" style="margin-top: 30px;">
                                        <tr class="first_header_font test-animals-row">
                                            <td class="label fw-bold" style="white-space: nowrap;font-size: 15px;">
                                                Test Animals:
                                            </td>
                                            <td colspan="3" style="text-align: left;font-size: 12px;">
                                                Rabbits (M/F) Rats (M/F) G.Pigs (M/F)
                                            </td>
                                        </tr>
                                        <tr class="first_header_font">
                                            <td class="label fw-bold" style="white-space: nowrap;font-size: 15px;">
                                                No Of Animals Used:
                                            </td>
                                            <td class="fw-bold" style="font-size: 15px;">
                                            </td>
                                        </tr>
                                        <tr class="first_header_font">
                                            <td class="fw-bold" style="white-space: nowrap;">Temperature (°C):</td>
                                            <td class="fw-bold" style="font-size: 15px;">
                                                <span t-esc="o.temperature"/>
                                            </td>
                                        </tr>
                                        <tr class="first_header_font">
                                            <td class="fw-bold">Humidity %:</td>
                                            <td class="fw-bold" style="font-size: 15px;">
                                                <span t-esc="o.humidity"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <!-- Results Table -->
                            <h5 style="text-align: left; margin-top: 20px; font-size: 16px; font-weight: bold;">
                                Results:
                            </h5>
                            <table class="table table-striped" style="border-collapse: collapse; width: 100%;">
                                <tr>
                                    <td style="border:1px solid black; padding: 8px; width: 8%; text-align: center; font-weight: bold;">
                                        Sr. No.
                                    </td>
                                    <td style="border: 1px solid black; padding: 8px; width: 20%; text-align: center; font-weight: bold;">
                                        Name of Test
                                    </td>
                                    <td style="border: 1px solid black; padding: 8px; width: 20%; text-align: center; font-weight: bold;">
                                        Dose Range Tested
                                    </td>
                                    <td style="border: 1px solid black; padding: 8px; width: 20%; text-align: center; font-weight: bold;">
                                        Units
                                    </td>
                                    <td style="border: 1px solid black; padding: 8px; width: 20%; text-align: center; text-decoration: underline;font-weight: bold;">
                                        Results
                                    </td>
                                    <td style="border: 1px solid black; padding: 8px; width: 20%; text-align: center; font-weight: bold;">
                                        Remarks
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid black; padding: 8px;">1.</td>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid black; padding: 8px;">2.</td>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid black; padding: 8px;">3.</td>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid black; padding: 8px;">4.</td>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid black; padding: 8px;">5.</td>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                    <td style="border: 1px solid black; padding: 8px;"/>
                                </tr>
                            </table>
                            <h5 style="text-align: left; margin-top: 80px; font-size: 16px; font-weight: bold;">
                                Interpretations/Comments:
                            </h5>
                            <h6 style="text-align: left; margin-top: 0; font-size: 14px;">
                                .
                            </h6>

                            <h7 style="text-align: left; margin-top: 0; font-size: 16px; font-weight: bold;">
                                Pathological Findings:
                            </h7>

                            <div style="display: flex; justify-content: space-between; margin-top: 20px;">
                                <div style="flex: 1; text-align: left;">(1)</div>
                                <div style="flex: 1; text-align: left;">(2)</div>
                                <div style="flex: 1; text-align: left;">(3)</div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </template>
        <!--        ...............................................HEADER & FOOTER OF TOXIOLOGY REPORT...........................-->
        <template id="toxic_temp">
            <t t-set="company" t-value="res_company"/>
            <div class="header">
                <table class="table table-sm table-borderless" style="border: 1px solid white;">
                    <tr>
                        <!-- Logo Section -->
                        <td style="width: 30%; text-align: left; vertical-align: middle;">
                            <t t-set="logo" t-value="company.logo and company.logo.decode('utf-8') or ''"/>
                            <img t-att-src="'data:image/png;base64,' + logo"
                                 style="max-height: 80px; margin-top: 0px; margin-bottom: 0px;"/>
                        </td>

                        <!-- Company Name and Address Section -->
                        <td style="width: 40%; vertical-align: middle;">
                            <p class="fw-bold"
                               style="font-size: 24px; text-align: center; margin-top: 0px; margin-bottom: 0px;"
                               t-esc="company.name"/>
                            <p style="margin-top: 0px; margin-bottom: 0px; text-align: center;">
                                <t t-esc="company.partner_id.street"/>
                            </p>
                        </td>

                        <!-- Document Info Section -->
                        <td style="width: 30%; text-align: right; vertical-align: middle;">
                            <p style="text-align: left; border: none; margin-top: 0px; margin-bottom: 0px; font-size: 14px;">
                                Doc ID
                            </p>
                            <p style="text-align: left; border: none; margin-top: 0px; margin-bottom: 0px; font-size: 14px;">
                                Issue Date
                            </p>
                            <p style="text-align: left; border: none; margin-top: 0px; margin-bottom: 0px; font-size: 14px;">
                                Rev.#
                            </p>
                        </td>
                    </tr>
                </table>

                <!-- Underline Section -->
                <div style="margin-top: 0px;"></div>
                <span style="display: block; text-decoration: underline; margin: 0 auto; width: 100%;">
                    ________________________________________________________________________________________________________________________
                </span>
            </div>
            <div class="footer">
                <div style="overflow: hidden; padding: 0 40px;">
                    <p style="float: left; text-align: left; margin: 0; width: 30%;">
                        ________________
                        <br style="text-align:center">Prepared By</br>
                    </p>
                    <p style="float: left; text-align: center; margin: 0; width: 40%;">
                        ________________
                        <br style="text-align:center">Reviewed By TM</br>
                    </p>
                    <p style="float: right; text-align: right; margin: 0; width: 30%;">
                        ________________
                        <br style="text-align:center">Approved By QC</br>
                    </p>
                </div>
                <div style="margin-bottom: 0px;"></div>
                <span style="display: block; text-decoration: underline; margin: 0 auto; width: 100%;">
                    ________________________________________________________________________________________________________________________
                </span>
                <h4 style="font-size: 13px;">Disclaimer:
                    <ul>
                        <li>As the sample is provided by the customers, the responsibility for the integrity of the
                            sample lies with the customers.
                        </li>
                        <li>Sampling was not performed by SUNCROP (Pvt) Ltd. Laboratory (TOXICOLOGY).</li>
                        <li>After completion of the test, the toxicity report and sample will be preserved for three
                            months.
                        </li>
                    </ul>
                </h4>
                <div style="display: flex; align-items: center; margin: 0 0 2px; font-size: 12px;">
                    <span>Print By:
                        <span t-esc="request.env.user.name"/>
                    </span>
                    <span style="margin-left: 30px;">Print Date/Time:
                        <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M')"/>
                    </span>
                </div>
            </div>
        </template>
    </data>
</odoo>
