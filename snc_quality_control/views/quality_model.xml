<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_quality_model_point_form" model="ir.ui.view">
            <field name="name">model.points.form</field>
            <field name="model">model.points</field>
            <field name="arch" type="xml">
                <form string="Quality Model Point">
                    <sheet>
                        <group>
                        </group>
                        <group>
                            <field name="temp_id"/>
                            <field name="name"/>
                            <field name="note"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_quality_model_point_tree" model="ir.ui.view">
            <field name="name">model.points.tree</field>
            <field name="model">model.points</field>
            <field name="arch" type="xml">
                <tree string="Quality Model Points">
                    <field name="temp_id"/>
                    <field name="name"/>
                    <field name="note"/>
                </tree>
            </field>
        </record>

        <record id="view_quality_model_point_search" model="ir.ui.view">
            <field name="name">model.points.search</field>
            <field name="model">model.points</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                </search>
            </field>
        </record>

        <record id="action_quality_model_point" model="ir.actions.act_window">
            <field name="name">Quality Model Points</field>
            <field name="res_model">model.points</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="menu_quality_model_point_action" name="Quality Model Points"
                  parent="quality_control.menu_quality_configuration" action="action_quality_model_point"
                  sequence="10"/>
    </data>
</odoo>
