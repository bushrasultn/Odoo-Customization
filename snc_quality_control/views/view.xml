<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Quality Point Form View Inheritance -->
        <record id="view_quality_point_form_inherit" model="ir.ui.view">
            <field name="name">quality.point.form.inherit</field>
            <field name="model">quality.point</field>
            <field name="inherit_id" ref="quality.quality_point_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='team_id']" position="after">
                    <field name="qc_temp_model_id"/>
                </xpath>
            </field>
        </record>

        <!-- Quality Check Form View Inheritance -->
        <record id="view_quality_check_form_inherit" model="ir.ui.view">
            <field name="name">quality.check.form.inherit</field>
            <field name="model">quality.check</field>
            <field name="inherit_id" ref="quality_control.quality_check_view_form"/>
            <field name="arch" type="xml">
                <!-- Adding additional fields after measure_on field -->
                <xpath expr="//field[@name='measure_on']" position="after">
                    <field name="mfg"/>
                    <field name="exp"/>
                    <field name="receive"/>
                    <field name="analysis"/>
                    <field name="report"/>
                    <field name="temperature"/>
                    <field name="humidity"/>
                    <field name="lot_producing_id"/>
                </xpath>
                <xpath expr="//field[@name='picking_id']" position="after">
                    <field name="origin" string="PO#:" readonly="1"/>
                    <field name="quantity" readonly="1"/>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="volume"/>
                </xpath>
                <xpath expr="//page[@name='notes']" position="after">
                    <page string="Other Info" name="other_info">
                        <group>
                            <field name="crop"/>
                            <field name="method"/>
                        </group>
                        <group>
                            <field name="vehicle_no" string="Vehicle No." readonly="1"/>
                            <field name="bilty_no" string="Bilty No." readonly="1"/>
                            <field name="user_id" string="Requested by:" readonly="1"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
        <!--        TREE VIEW -->
        <record id="view_quality_check_tree_inherit" model="ir.ui.view">
            <field name="name">quality.check.tree.inherit</field>
            <field name="model">quality.check</field>
            <field name="inherit_id" ref="quality_control.quality_check_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="origin" string="PO#:"/>
                    <field name="picking_id" optional="Hide"/>
                    <field name="production_id" optional="Hide"/>
                </xpath>
                <xpath expr="//field[@name='lot_id']" position="attributes">
                    <attribute name="optional">hide</attribute>
                </xpath>
            </field>
        </record>
        <!--        ...................................SEARCH VIEW.....................................-->
        <record id="view_quality_check_search_inherit" model="ir.ui.view">
            <field name="name">quality.check.search.inherit</field>
            <field name="model">quality.check</field>
            <field name="inherit_id" ref="quality_control.quality_check_view_search"/>
            <field name="arch" type="xml">
                <xpath expr="//search" position="inside">
                    <field name="product_id"/>
                    <field name="origin" string="PO#"/>
                    <field name="picking_id" string="Picking"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
