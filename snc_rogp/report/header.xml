<odoo>
    <data>
        <template id="outward">
            <t t-set="company" t-value="res_company"/>
            <div class="header" style="text-align: center; margin-bottom: 20px;">
                <div class="row" style="border-bottom: 1px solid #000; padding-bottom: 10px; margin-bottom: 10px;">
                    <div class="col-2">
                        <t t-set="logo" t-value="company.logo and company.logo.decode('utf-8') or ''"/>
                        <img t-att-src="'data:image/png;base64,' + logo" style="max-height: 80px;"/>
                    </div>
                    <div class="col-8">
                        <p style="font-size: 24px; font-weight: bold; margin: 0;text-align: center;">
                            <t t-esc="company.name"/>
                        </p>
                        <p style="margin: 0; text-align: center;">
                            <t t-esc="company.partner_id.street"/>
                        </p>
                    </div>
                </div>
            </div>
            <t t-raw="content"/>
            <div class="footer" style="text-align: left; margin-top: 20px; white-space: nowrap;">
                <p style="display: inline-block; width: 150px; margin-right: 50px;">
                    ________________
                    <br>Prepared By:</br>
                </p>
                <p style="display: inline-block; width: 150px; margin-right: 50px;">
                    ________________
                    <br>Dispatch By:</br>
                </p>
                <p style="display: inline-block; width: 150px; margin-right: 50px;">
                    ________________
                    <br>Security:</br>
                </p>
                <p style="display: inline-block; width: 150px; margin-right: 50px;">
                    ________________
                    <br>Acknowledgement</br>
                </p>
                <p style="display: inline-block; width: 150px;">
                    ________________
                    <br>Accounts / Logistics</br>
                </p>
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin: 0 0 5px;">
                    <div style="margin: 0; padding: 0; font-size: 12px;">
                        Print By:
                        <span t-esc="request.env.user.name"/>
                    </div>
                    <div style="text-align: left; margin: 0; padding: 0; font-size: 12px; margin-top: 3px;">
                        Print Date/Time:
                        <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                    </div>
                </div>
            </div>
        </template>
    </data>
</odoo>
