<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_location_form" model="ir.ui.view">
        <field name="name">location.form</field>
        <field name="model">return.location</field>
        <field name="arch" type="xml">
            <form string="Location">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="type"/>
                            <field name="is_transit"/>
                        </group>
                        <group>
                            <field name="warehouse"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_location_tree" model="ir.ui.view">
        <field name="name">location.tree</field>
        <field name="model">return.location</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="type"/>
                <field name="warehouse"/>
                <field name="is_transit"/>
            </tree>
        </field>
    </record>
    <record id="action_location" model="ir.actions.act_window">
        <field name="name">Location</field>
        <field name="res_model">return.location</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_location_tree"/>
    </record>

    <menuitem id="menu_location_root"
              name="Returnables Location"
              parent="stock.menu_warehouse_config"
              action="action_location"
              sequence="10"/>
</odoo>
