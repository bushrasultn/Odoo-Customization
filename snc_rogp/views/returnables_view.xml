<odoo>
    <data>
        <record id="returnables_form" model="ir.ui.view">
            <field name="name">Returnables Form</field>
            <field name="model">returnable.valuation</field>
            <field name="arch" type="xml">
                <form create="false">
                    <header>
                        <field name="state" widget="statusbar" readonly="True"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="True"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="cont"/>
                                <field name="warehouse"/>
                                <field name="source"/>
                                <field name="destination"/>
                            </group>
                            <group>
                                <field name="date"/>
                                <field name="remark"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Lines">
                                <field name="returnable_val_line_ids" readony="True">
                                    <tree editable="bottom">
                                        <field name="product_id" options="{'no_create': False}"/>
                                        <field name="quantity"/>
                                        <field name="unit_id"/>
                                        <field name="specify"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="returnable_val_tree" model="ir.ui.view">
            <field name="name">Returnables</field>
            <field name="model">returnable.valuation</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" readonly="True"/>
                    <field name="cont"/>
                    <field name="warehouse"/>
                    <field name="doc_type"/>
                    <field name="outward_records"/>
                    <field name="returnable_id"/>
                    <field name="outward_id"/>
                    <field name="date"/>
                    <field name="remark"/>
                    <field name="state" widget="badge"/>
                </tree>
            </field>
        </record>
        <record id="returnable_val_search" model="ir.ui.view">
            <field name="name">returnable.valuation.search</field>
            <field name="model">returnable.valuation</field>
            <field name="arch" type="xml">
                <search string="_tree">
                    <field name="name"/>
                    <field name="cont"/>
                    <field name="warehouse"/>
                    <field name="date"/>
                    <field name="state"/>
                    <filter name="filter_state" string="State" domain="[('state', '=', 'open')]"/>
                    <filter name="filter_state" string="State" domain="[('state', '=', 'submitted')]"/>
                </search>
            </field>
        </record>
        <record id="returnable_action" model="ir.actions.act_window">
            <field name="name">Returnables</field>
            <field name="res_model">returnable.valuation</field>
            <field name="view_mode">tree,search</field>
        </record>
        <menuitem id="menu_return_root" name="Returnables" parent="stock.menu_stock_warehouse_mgmt"/>
        <menuitem id="returnables_outward" name="Returnables" parent="menu_return_root" action="returnable_action"
                  sequence="3"/>
        <record id="returnable_val_line_tree" model="ir.ui.view">
            <field name="name">Returnables</field>
            <field name="model">returnable.valuation.line</field>
            <field name="arch" type="xml">
                <tree create="false">
                    <field name="name" readonly="True"/>
                    <field name="returnable_id" readonly="True" optional="Hide"/>
                    <field name="outward_id" readonly="True" optional="Hide"/>
                    <field name="cont" optional="Hide"/>
                    <field name="warehouse"/>
                    <field name="source"/>
                    <field name="destination"/>
                    <field name="product_id"/>
                    <field name="quantity"/>
                    <field name="doc_type"/>
                    <field name="date"/>
                    <field name="remark"/>
                    <field name="state" widget="badge"/>
                </tree>
            </field>
        </record>
        <record id="returnable_val_lines_action" model="ir.actions.act_window">
            <field name="name">Returnables</field>
            <field name="res_model">returnable.valuation.line</field>
            <field name="view_mode">tree</field>
        </record>
        <menuitem id="menu_return_root" name="Returnables" parent="stock.menu_stock_warehouse_mgmt"/>
        <menuitem id="returnables_lines_outward" name="Returnables History" parent="menu_return_root"
                  action="returnable_val_lines_action"
                  sequence="3"/>

    </data>
</odoo>