<odoo>
    <data>
        <record id="view_gate_pass_form" model="ir.ui.view">
            <field name="name">gate.pass.form</field>
            <field name="model">gate.pass</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="state" widget="statusbar" readonly="True"/>
                        <button name="action_open" type="object" invisible="state == 'open'" string="Open"
                                class="oe_highlight"/>
                        <button name="action_return" type="object" invisible="state == 'submitted'" string="Submit"
                                class="oe_highlight"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="True"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="cont"
                                       readonly="state in ['submitted']"/>
                                <field name="warehouse" required="[[loc_type == 'vendor']]"
                                       readonly="state in ['submitted']"/>
                                <field name="transit_loc_domain" invisible="True" required="[[loc_type == 'vendor']]"
                                       readonly="state in ['submitted']"/>
                                <field name="not_transit_loc_domain" invisible="True"
                                       required="[[loc_type == 'vendor']]"/>
                                <field name="source" domain="not_transit_loc_domain" readonly="state in ['submitted']"/>
                                <field name="destination" domain="transit_loc_domain"
                                       readonly="state in ['submitted']"/>
                                <field name="dept" readonly="state in ['submitted']"/>
                            </group>
                            <group>
                                <field name="doc_type" on_change="onchange_doc_type" readonly="state in ['submitted']"/>
                                <field name="loc_type" widget="radio" readonly="state in ['submitted']" options="{'horizontal': True}"/>
                                <field name="date" readonly="state in ['submitted']"/>
                                <field name="remark" readonly="state in ['submitted']"/>
                                <field name="rogp_state" readonly="1"
                                       invisible="doc_type == 'returnable inward'"/>
                                <field name="outward_records"
                                       invisible="doc_type == 'returnable outward'"
                                       readonly="state in ('submitted', 'partially_returned', 'returned')"/>
                                <field name="inward_records"
                                       invisible="doc_type == 'returnable inward' or loc_type == 'vendor'"
                                       readonly="state in ['submitted']" domain="[('rigp_state', '!=', 'returned'),('doc_type', '=', 'returnable inward'), ('loc_type', '!=', 'vendor')]"/>
                                 <field name="rigp_state" readonly="1"
                                       invisible="doc_type == 'returnable outward'"/>
                                <field name="company_id" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Products">
                                <field name="product_line_ids" readonly="state in ['submitted']">
                                    <tree editable="bottom">
                                        <field name="product_id" options="{'no_create': False}" readonly="state in ['submitted']"/>
                                        <field name="quantity" readonly="state in ['submitted']"/>
                                        <field name="returned_quantity" force_save="True" readonly="True" />
                                        <field name="unit_id" readonly="state in ['submitted']"/>
                                        <field name="specify" readonly="state in ['submitted']"/>
                                        <field name="state"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Other Information">
                                <group>
                                    <field name="security" readonly="state in ['submitted']"/>
                                </group>
                                <group>
                                    <field name="builty_no" readonly="state in ['submitted']"/>
                                    <field name="vehicle" readonly="state in ['submitted']"/>
                                </group>
                                <group>
                                    <field name="trnsprt" readonly="state in ['submitted']"/>
                                    <field name="drvr" readonly="state in ['submitted']"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="activity_ids"/>
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        <record id="view_gate_pass_tree" model="ir.ui.view">
            <field name="name">gate.pass.tree</field>
            <field name="model">gate.pass</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" readonly="True"/>
                    <field name="cont"/>
                    <field name="warehouse"/>
                    <field name="doc_type"/>
                    <field name="outward_records" invisible="doc_type=='returnable outward'" optional="Hide"/>
                    <field name="inward_records" invisible="doc_type=='returnable inward'"/>
                    <field name="returnable_id" invisible="1" optional="Hide"/>
<!--                    <field name="inward_id" invisible="1" optional="Hide"/>-->
                    <field name="date"/>
                    <field name="remark"/>
                    <field name="state"/>
                    <field name="rogp_state" string="ROGP State" readonly="state=='submitted'"/>
                    <field name="rigp_state" string="RIGP State" readonly="state=='submitted'" invisible="doc_type=='returnable outward'"/>
                </tree>
            </field>
        </record>
        <!--          SEARCH VIEW -->
        <record id="view_gate_pass_search" model="ir.ui.view">
            <field name="name">gate.pass.search</field>
            <field name="model">gate.pass</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="cont"/>
                    <field name="warehouse"/>
                    <field name="doc_type"/>
                    <field name="date"/>
                    <field name="state"/>
                </search>
            </field>
        </record>
        <record id="action_gate_pass_outward" model="ir.actions.act_window">
            <field name="name">Returnables Outward</field>
            <field name="res_model">gate.pass</field>
            <field name="view_mode">tree,form,search</field>
            <field name="context">{'default_doc_type': 'returnable outward', 'default_is_returnable inward': False}
            </field>
            <field name="domain">[('doc_type', '=', 'returnable outward')]</field>
            <field name="view_id" ref="view_gate_pass_tree"/>
        </record>
        <menuitem id="menu_return_root" name="Returnables" parent="stock.menu_stock_warehouse_mgmt"/>
        <menuitem id="menu_deliver_outward" name="Outward" parent="menu_return_root" action="action_gate_pass_outward"
                  sequence="1"/>
    </data>
</odoo>